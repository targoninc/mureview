{
  "name": "mureview",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build && bun run build:server",
    "build:server": "bun build src/server/index.ts --target bun --outfile dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "start": "bun run src/server/index.ts",
    "start-prod": "bun run dist-server/index.js"
  },
  "dependencies": {
    "@atproto-labs/handle-resolver": "^0.4.10",
    "@atproto/api": "^0.25.0",
    "@atproto/oauth-client-node": "^0.5.9",
    "@pierre/diffs": "^1.5.2",
    "@pierre/trees": "1.0.0-beta.6",
    "@primer/octicons-react": "^19.40.0",
    "@primer/react": "^38.40.1",
    "diff": "^9.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-is": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
