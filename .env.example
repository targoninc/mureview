# Public base URL of the deployment (used for GitHub OAuth redirects and links)
BASE_URL=http://localhost:8081

# GitHub OAuth app credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: override the GitHub callback URL, e.g. when the OAuth app has the
# legacy https://your-host/api/auth/callback registered.
# GITHUB_REDIRECT_URI=https://your-host/api/auth/callback

# Microsoft Entra ID sign-in (https://entra.microsoft.com). Register an app,
# add the redirect URI ${BASE_URL}/api/auth/callback/entra and paste the
# credentials here. ENTRA_TENANT defaults to "common" (work, school and
# personal Microsoft accounts).
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT=common

# Optional: override the session/token encryption secret. Generated and stored
# in the database when unset.
# SESSION_SECRET=

# Optional: port and sqlite database location
# PORT=8081
# DATABASE_PATH=data/mureview.db
